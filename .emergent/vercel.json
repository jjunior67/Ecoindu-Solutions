{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "backend/api/calcular-carbono.py"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/build/$1"
    }
  ],
  "functions": {
    "backend/api/*.py": {
      "runtime": "vercel-python@3.0.7"
    }
  }
}